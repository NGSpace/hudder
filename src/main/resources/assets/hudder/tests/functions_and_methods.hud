|TEST:

@name=While and return
@mode=normal

input:
	#def while_and_return
		#while true
			;return, true;
		;return, false;
	{while_and_return()}
end_input;

output:
	true
end_output;

END_TEST;



|TEST:

@name=For and return
@mode=normal

input:
	#def while_and_return
		#for x in range(1)
			;return, true;
		;return, false;
	{while_and_return()}
end_input;

output:
	true
end_output;

END_TEST;



|TEST:

@name=Def and Break
@mode=normal

input:
	;mute;
	#def breaktest
		{r="y"}
		{break}
		{r="t"}
	;breaktest;
	;topleft;
	{r}
end_input;

output:
	y
end_output;

END_TEST;



|TEST:

@name=If and return
@mode=normal

input:
	#def while_and_return
		#if true
			;return, true;
		;return, false;
	{while_and_return()}
end_input;

output:
	true
end_output;

END_TEST;



|TEST:

@name=Putall method
@mode=normal

input:
	#def putall, string, number, boolean, array, any
		{str=int(arg1)}
		{num=str(arg2)}
		{bool=arg3==false}
		{array=arg4[0]}
		{any=arg5}
	;putall, "1", 10, true, ["yes","no"], "no";
	{str} {num} {bool} {array} {any}
end_input;

output:
	1 10.0 false yes no
end_output;

END_TEST;



|TEST:

@name=Divide method
@mode=normal

input:
	#def divide, num1, num2
		{result=num1/arg2}
	;divide, 4, 2;
	{result}
end_input;

output:
	2
end_output;

END_TEST;



|TEST:

@name=Spaced divide method
@mode=normal

input:
	#def divide, num1, num2
		{result=num1/arg2}
	; divide, 4, 2;
	{result}
end_input;

output:
	2
end_output;

END_TEST;



|TEST:

@name=Divide function
@mode=normal

input:
	#def divide, num1, num2
		#if num2==0
			;return, -1;
		;return, arg1/arg2;
	{divide(4,2)} {divide(4,0)}
end_input;

output:
	2 -1
end_output;

END_TEST;



|TEST:

@name=Uncertain function
@mode=error
@exception_type=CompileException

input:
	#def divide, num1, num2
		#if num2==0
			;return, -1;
		oww no return value? too bad
end_input;

output:
	Function "divide" does not always return a value!
end_output;

END_TEST;



|TEST:

@name=Too many args in call to user function
@mode=error
@exception_type=CompileException

input:
	#def divide, num1
		;return, -1;
	;divide, -1, -2;
end_input;

END_TEST;



|TEST:

@name=Too little args in call to user function
@mode=error
@exception_type=CompileException

input:
	#def divide, num1
		;return, -1;
	;divide;
end_input;

END_TEST;



|TEST:

@name=Too many args in call to user method
@mode=error
@exception_type=CompileException

input:
	#def divide, num1
		{break}
	;divide, -1, -2;
end_input;

END_TEST;



|TEST:

@name=Too little args in call to user method
@mode=error
@exception_type=CompileException

input:
	#def divide, num1
		{break}
	;divide;
end_input;

END_TEST;
