|TEST:

@name=Equals inside strings
@mode=normal

input:
	{r=43} {"result="+r} {"result="+1} {"result="}
end_input;

output:
	43 result=43 result=1 result=
end_output;

END_TEST;



|TEST:

@name=New line concatination
@mode=normal

input:
	{"r" + "\n" + "o"}
end_input;

output:
	r
	o
end_output;

END_TEST;



|TEST:

@name=Basic text
@mode=normal

input:
	Basic Bitch Test
end_input;

output:
	Basic Bitch Test
end_output;

END_TEST;



|TEST:

@name=String newlines
@mode=normal

input:
	{"r\nr"}
end_input;

output:
	r
	r
end_output;

END_TEST;



|TEST:

@name=Math and string
@mode=normal

input:
	{1+2+"r"}
end_input;

output:
	12r
end_output;

END_TEST;



|TEST:

@name=Concatination using plus
@mode=normal

input:
	{"X: " + 1 + " Y: " + 60 + " Z: " + 0}
end_input;

output:
	X: 1 Y: 60 Z: 0
end_output;

END_TEST;



|TEST:

@name=Class access and math
@mode=normal

input:
	{"Days: ".concat(string(int(1/2),true))}
end_input;

output:
	Days: 0
end_output;

END_TEST;



|TEST:

@name=String brackets
@mode=normal

input:
	{"{}}"}
end_input;

output:
	{}}
end_output;

END_TEST;



|TEST:

@name=Text concatination
@mode=normal

input:
	{str(10,true).concat("test")}
end_input;

output:
	10test
end_output;

END_TEST;



|TEST:

@name=Text substring
@mode=normal

input:
	{"Long text".substring(1, 4)}
end_input;

output:
	ong
end_output;

END_TEST;



|TEST:

@name=Text repeat
@mode=normal

input:
	{"Repeat".repeat(2)}
end_input;

output:
	RepeatRepeat
end_output;

END_TEST;



|TEST:

@name=Text length
@mode=normal

input:
	{length("Length")}
end_input;

output:
	6
end_output;

END_TEST;



|TEST:

@name=String with quotes
@mode=normal

input:
	{"1 \"2\" 3"}
end_input;

output:
	1 "2" 3
end_output;

END_TEST;



|TEST:

@name=String case sensitivity
@mode=normal

input:
	{"CaSE SenSitive"} {r="CaSE SenSitive"} {r}
end_input;

output:
	CaSE SenSitive CaSE SenSitive CaSE SenSitive
end_output;

END_TEST;
