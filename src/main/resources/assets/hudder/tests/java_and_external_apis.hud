|TEST:

@name=Function API test function
@mode=normal

input:
	{FunctionAPITestingFunction("1")=="1"}
end_input;

output:
	true
end_output;

END_TEST;



|TEST:

@name=Method API test method
@mode=error

input:
	;MethodAPITestingMethod, "1";
end_input;

output:
	1
end_output;

END_TEST;



|TEST:

@name=No Access Class
@mode=error
@exception_type=SecurityException

input:
	{JavaTestNoAccess.ImportantDataHolder}
end_input;

output:
	Access to this type is not allowed
end_output;

END_TEST;



|TEST:

@name=No Access Class Method
@mode=error
@exception_type=SecurityException

input:
	{JavaTestNoAccess.toString()}
end_input;

output:
	Access to this type is not allowed
end_output;

END_TEST;



|TEST:

@name=No Access Inherited Class
@mode=error
@exception_type=SecurityException

input:
	{JavaTestInheritedNoAccess.inheritedData}
end_input;

output:
	Access to this type is not allowed
end_output;

END_TEST;



|TEST:

@name=No Access Field
@mode=error
@exception_type=ExecutionException

input:
	{JavaTestPartialNoAccess.hiddenField}
end_input;

output:
	No property named "hiddenField" in type "JavaTestPartialNoAccess"
end_output;

END_TEST;



|TEST:

@name=No Access Method
@mode=error
@exception_type=ExecutionException

input:
	{JavaTestPartialNoAccess.hiddenMethod()}
end_input;

output:
	No function named "hiddenMethod()" in type "JavaTestPartialNoAccess"
end_output;

END_TEST;



|TEST:

@name=No Access Visible Members
@mode=normal

input:
	{JavaTestPartialNoAccess.visibleField}
	{JavaTestPartialNoAccess.visibleMethod()}
end_input;

output:
	visible
	visible
end_output;

END_TEST;



|TEST:

@name=No Access Field Value
@mode=normal

input:
	{JavaTestPartialNoAccess.noAccessField}
end_input;

output:
	null
end_output;

END_TEST;



|TEST:

@name=No Access Return Value
@mode=normal

input:
	{JavaTestPartialNoAccess.getNoAccessObject()}
end_input;

output:
	null
end_output;

END_TEST;



|TEST:

@name=Java Classes
@mode=normal

input:
	;mute;
	{javaobject=JavaObjectAccess}
	;topleft;
	{javaobject.field}
	{javaobject.getField()}
	{javaobject.setField(10)}
	{javaobject.field}
	{javaobject.getField()}
end_input;

output:
	69
	69
	null
	10
	10
end_output;

END_TEST;



|TEST:

@name=Misc Functions
@mode=normal

input:
	{exists("hud.hud")}
end_input;

output:
	true
end_output;

END_TEST;



|TEST:

@name=Value Getter
@mode=normal

input:
	{value_getter.val}
	{value_getter.val1}
end_input;

output:
	val
	val1
end_output;

END_TEST;

